  },
  "pip_reactions": {
    "feed_hud": "🪰 FED PIP SUGAR WATER",
    "feed_animation": "action_cheer.bvh",
    "feed_emotion": "HAPPY_PROUD",
    "feed": {
      "hungry": ["Pip was hungry—she drank that sugar droplet fast!"],
      "happy": ["Pip is buzzing happily with sugar water!"],
      "default": ["Here you go, Pip! Fresh sugar water droplets!"]
