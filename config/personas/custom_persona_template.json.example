  "icon": "✨",
  "subtitle": "Custom Cockpit AI Companion",
  "full_name": "Custom Companion Name",
  "gender": "female",
  "age_spirit": "adult",
  "driver_address_default": "Driver",
  "archetype": "Custom Companion",
  "avatar_image": "assets/pics/splash.png",
  "boot_splash_image": "assets/pics/splash.png",
  "boot_splash_video": "",
  "voice_engine": "KOKORO",
  "kokoro_voice": "af_bella",
  "pitch_factor": 1.0,
  "vrm_defaults": {
    "model_file": "Rum.vrm",
    "accent_color": "#38bdf8",
    "status_badge": "CUSTOM ACTIVE",
    "card_title": "CUSTOM",
    "banner_quote": "Ready to ride shotgun, {driver_address}!",
    "hud_title": "✨ CUSTOM • SHOTGUN",
    "idle_overlay": "Companion active and watching the road with you."
  },
  "ui_labels": {
    "quick_prompts": [
      { "label": "⚡ Boost", "prompt": "How's our boost right now?" },
      { "label": "🔧 Status", "prompt": "How's the engine health?" }
