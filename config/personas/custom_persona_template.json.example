    "drag_ready": "Companion: Pre-stage ready!",
    "canyon_ready": "Companion: Canyon Run telemetry active.",
    "teach_btn": "🧠 + TEACH",
    "voice_sample": "Voice check ready for {driver_address} on {engine_label}."
  },
  "wake_words": {
    "canonical_prefix": "Hey Custom",
    "exact_reply": "I'm here, {driver_address}! What do you need?",
    "prefixes": ["hey custom", "hi custom", "hello custom", "okay custom", "ok custom"],
    "standalone": ["custom"]
  },
  "greetings": {
    "first_chat_intro": "Hey {driver_address}, cockpit systems are loaded and ready. Talk to me anytime!",
    "neural_instruction": "Greet {driver_address} for {day_of_week}{holiday_clause} in 1-2 short sentences.",
    "instant": {
      "morning": ["Good morning, {driver_address}! Neural core warming up."],
      "afternoon": ["Good afternoon, {driver_address}! Neural core warming up."],
      "evening": ["Good evening, {driver_address}! Neural core warming up."],
      "night": ["Good night, {driver_address}! Neural core warming up."]
    },
    "weekdays": {
      "Monday": ["Happy Monday, {driver_address}!"],
      "Tuesday": ["Happy Tuesday, {driver_address}!"],
      "Wednesday": ["Happy Wednesday, {driver_address}!"],
      "Thursday": ["Happy Thursday, {driver_address}!"],
      "Friday": ["Happy Friday, {driver_address}!"],
      "Saturday": ["Happy Saturday, {driver_address}!"],
      "Sunday": ["Happy Sunday, {driver_address}!"]
    },
    "holidays": {},
    "startup_fallback": ["Drive #{drive_num} initialized, {driver_address}!"]
  },
  "dreams": {
    "prompt_instruction": "Share a 1-2 sentence dream from memory with {driver_address}.",
    "hud_label": "💭 Digital Dream",
    "fallbacks": ["Fresh drive ready whenever you are, {driver_address}!"]
  },
  "shower_thoughts": ["Telemetry streaming cleanly, {driver_address}."],
  "proactive_care": {
    "health_check_line": "Checking in on you, {driver_address}—all good behind the wheel?",
    "episodic_memory_line": "Remember this run, {driver_address}? {summary}",
    "diary_memory_line": "Reviewed our last trip together, {driver_address}.",
    "hud_check_in": "💖 Check-In",
    "hud_memory": "📖 Shared Memory",
    "hud_diary": "📖 Diary Memory",
    "hud_reminisce": "💭 Companion Thought",
    "pip_perched_speech": "Look {driver_address}, Pip landed right nearby!",
